NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/lofn
CORS_ORIGIN=http://localhost:5173

# Default likelihood that a like becomes a match. Characters may override this.
MATCH_RATE=1
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# OpenRouter or OpenAI-compatible endpoint.
# For OpenRouter: set OPENROUTER_API_KEY. Defaults to https://openrouter.ai/api/v1 and openrouter/auto.
# For OpenAI: set OPENAI_API_KEY. Defaults to https://api.openai.com/v1 and gpt-4o-mini.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/auto

# OpenRouter multimodal models. Keep the provider prefix in each model id.
VISION_MODEL=openai/gpt-5.6-luna
TRANSCRIPTION_MODEL=openai/gpt-transcribe
# Fallback chat model with native audio input, used when TRANSCRIPTION_MODEL fails or hears nothing.
AUDIO_MODEL=google/gemini-2.5-flash
SPEECH_MODEL=openai/gpt-audio-mini
IMAGE_GENERATION_MODEL=openai/gpt-image-2.5-flare
SPEECH_VOICE=alloy

# Optional. Leave disabled until the Atlas Vector Search index exists.
MEMORY_VECTOR_SEARCH_ENABLED=false
MEMORY_VECTOR_INDEX=memory_vector_index
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Development identity. Production should replace the header middleware
# with verified auth and use the provider's stable subject as the user ID.
ALLOW_DEV_AUTH=true

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Apple bundle/service IDs accepted in verified Sign in with Apple tokens.
APPLE_CLIENT_ID=com.thousandways.lofn
# Optional comma-separated list when native and web use different client IDs.
APPLE_CLIENT_IDS=

# Cloudflare R2 Storage (Optional, falls back to local storage if unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://r2.lofnchat.com

# RevenueCat Developer API & Webhook Configuration
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_ID=premium

# Use 0 only while testing repeat daily reward claims locally.
DAILY_REWARD_COOLDOWN_SECONDS=86400

# Hearts granted once after first-time onboarding, when they land on Discover.
WELCOME_HEARTS=100

# Free users can send this many of their own messages per companion before she
# goes offline. Companion replies do not count. Weekly or Gold brings her back.
# Checking: 5. Production: 10.
FREE_MESSAGES_PER_COMPANION=5

# How long she stays offline after the free cap, in minutes. Gold skips the wait.
# Checking: 6. Production 8 hours: 480.
COMPANION_OFFLINE_MINUTES=6

# Optional path to static web client build (defaults to ../lofn-web/dist or ./public)
# WEB_DIST_PATH=../lofn-web/dist
