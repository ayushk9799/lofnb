{
  "name": "lofn-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:4000",
    "start": "node server.js",
    "seed": "node src/seed.js",
    "characters:import": "node src/seed.js",
    "test": "vitest run",
    "build": "node scripts/check.js",
    "build:web": "npm --prefix ../lofn-web run build",
    "bundle:web": "npm --prefix ../lofn-web run build && node scripts/copy-web.js",
    "db:audit": "node scripts/database.js",
    "db:migrate": "node scripts/database.js --apply",
    "db:clear": "node scripts/clear-data.js",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "multer": "^2.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "vitest": "^3.2.4"
  }
}
